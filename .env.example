# Neon Postgres connection string (server-only; never prefix with NEXT_PUBLIC_)
DATABASE_URL=

# Vercel-native OmniRoute-compatible gateway adapter.
# Set OMNIROUTE_VERCEL_NATIVE=true to route BlueHaven agents through /api/omniroute/v1.
OMNIROUTE_VERCEL_NATIVE=false
# Optional production URL override; otherwise Vercel's VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL is used.
OMNIROUTE_VERCEL_BASE_URL=
# Optional separate key for direct gateway clients. AGENT_SERVICE_TOKEN is also accepted server-side.
OMNIROUTE_API_KEY=
# Optional upstream override; usually an OpenAI-compatible API base ending in /v1.
OMNIROUTE_UPSTREAM_BASE_URL=
OMNIROUTE_UPSTREAM_API_KEY=

# Existing provider gateway (used as upstream by the adapter and directly when native mode is off).
# OpenRouter default: https://openrouter.ai/api/v1
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=
OPENROUTER_API_KEY=

# Optional API service URL for a separately hosted agent worker
NEXT_PUBLIC_API_URL=

# Server-only worker authentication token for agent execution
AGENT_SERVICE_TOKEN=

# Company governance tokens (server-only; use separate long random values)
MATTHEW_SERVICE_TOKEN=
CHO_ADMIN_TOKEN=
CRON_SECRET=

# First-party social publishing OAuth apps.
# Add values only after creating apps in the corresponding official developer portals.
# Callback URLs must match the implemented OAuth routes exactly.
# Never expose these values through NEXT_PUBLIC_ variables.
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# Generate a random 32-byte key encoded as 64 hexadecimal characters.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Amazon Associates / Creators API (separate from social publishing).
AMAZON_CREATORS_API_KEY=
AMAZON_CREATORS_API_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.com
