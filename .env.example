# Neon Postgres connection string (server-only; never prefix with NEXT_PUBLIC_)
DATABASE_URL=

# Optional unified OpenAI-compatible gateway
# OpenRouter default: https://openrouter.ai/api/v1
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=

# Optional fallback name if using an OpenRouter-specific key
OPENROUTER_API_KEY=

# Optional API service URL for a separately hosted agent worker
NEXT_PUBLIC_API_URL=

# Server-only worker authentication token for a future dedicated job runner
AGENT_SERVICE_TOKEN=
