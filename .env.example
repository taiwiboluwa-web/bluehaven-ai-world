# Neon Postgres connection string (server-only; never prefix with NEXT_PUBLIC_)
DATABASE_URL=

# Optional unified OpenAI-compatible gateway
# OpenRouter default: https://openrouter.ai/api/v1
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=

# Optional fallback name if using an OpenRouter-specific key
OPENROUTER_API_KEY=

# Optional API service URL for a separately hosted agent worker
NEXT_PUBLIC_API_URL=

# Server-only worker authentication token for agent execution
AGENT_SERVICE_TOKEN=

# Company governance tokens (server-only; use separate long random values)
MATTHEW_SERVICE_TOKEN=
CHO_ADMIN_TOKEN=
CRON_SECRET=

# First-party social publishing OAuth apps.
# Add values only after creating apps in the corresponding official developer portals.
# Callback URLs must match the implemented OAuth routes exactly.
# Never expose these values through NEXT_PUBLIC_ variables.

# Meta: Instagram Graph API + Facebook Pages
META_APP_ID=
META_APP_SECRET=

# X API
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google OAuth for Blogger API and YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pinterest API
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Tumblr API
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=

# WordPress.com API
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# Encryption key for provider tokens at rest.
# Generate a random 32-byte key encoded as 64 hexadecimal characters.
# Store only in Vercel server-side environment variables or a managed secret store.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Amazon Associates / Creators API (separate from social publishing).
# Use credentials issued to your own eligible Associates account.
AMAZON_CREATORS_API_KEY=
AMAZON_CREATORS_API_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.com
